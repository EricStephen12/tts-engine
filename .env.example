# --- Server ---
TTS_HOST=0.0.0.0
TTS_PORT=8100
TTS_LOG_LEVEL=INFO
TTS_LOG_JSON=true

# --- Security ---
# Comma-separated list of valid API keys accepted via the `X-API-Key` header.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TTS_API_KEYS=change-me-dev-key
TTS_CORS_ORIGINS=http://localhost:3000

# --- Rate limiting ---
TTS_RATE_LIMIT=60/minute

# --- Model ---
# auto | cpu | cuda
TTS_DEVICE=auto
TTS_MODEL_PATH=models/weights/kokoro-v1.0.onnx
TTS_VOICES_PATH=models/weights/voices-v1.0.bin
TTS_DEFAULT_VOICE=af_heart
TTS_DEFAULT_LANG=a
TTS_SAMPLE_RATE=24000

# --- Limits ---
TTS_MAX_TEXT_LENGTH=5000
